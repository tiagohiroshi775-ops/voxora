{
  "name": "voxora-desktop",
  "version": "1.5.0",
  "description": "Voxora para Windows",
  "author": "Voxora",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.voxora.desktop",
    "productName": "Voxora",
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Voxora-Setup-${version}.${ext}"
  }
}