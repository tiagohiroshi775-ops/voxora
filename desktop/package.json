{
  "name": "voxora-desktop",
  "version": "1.5.2",
  "description": "Voxora para Windows",
  "author": "Voxora",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.voxora.desktop",
    "productName": "Voxora",
    "files": [
      "main.cjs",
      "package.json",
      "splash.html",
      "updater.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Voxora-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "tiagohiroshi775-ops",
        "repo": "voxora",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
